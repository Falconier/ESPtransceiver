diff --git a/firmware/Makefile b/firmware/Makefile
index d620c4a..5e8229d 100644
--- a/firmware/Makefile
+++ b/firmware/Makefile
@@ -12,6 +12,14 @@ ESPTOOL ?= esptool.py
 NARROWBAND ?= 1
 # TX=1 adds the experimental transmitter (protocol/transmit.h). It is a separate image: the receiver image contains no transmit code.
 TX ?= 0
+# BEACON=1 builds the standalone CW beacon: the transmitter driven by BEACON_SRC instead of main.c's command loop, with no host.
+# BEACON_DEFS passes its settings, e.g. BEACON_DEFS="-DBEACON_WPM=15 -DLED_GPIO=38".
+BEACON ?= 0
+BEACON_SRC ?= src/beacon.c
+ifeq ($(BEACON),1)
+TX := 1
+BUILD ?= build-beacon
+endif
 ifeq ($(TX),1)
 BUILD ?= build-tx
 else ifeq ($(NARROWBAND),1)
@@ -61,6 +69,9 @@ NB_FLAGS := -DESPDR_NARROWBAND=1
 ifeq ($(TX),1)
 NB_FLAGS += -DESPDR_TX=1
 endif
+ifeq ($(BEACON),1)
+NB_FLAGS += -DESPDR_BEACON=1 $(BEACON_DEFS)
+endif
 ifeq ($(PROFILE),1)
 NB_FLAGS += -DPROFILE=1 # per-section cycle counters in dsp_unit(), read with `espdr_nb.py dspbench --profile`
 endif
@@ -87,6 +98,10 @@ ifeq ($(NARROWBAND),1)
 APP_SOURCES += dsp.c stream.c app_desc.c
 NB_OBJECTS := $(BUILD)/dsp_core1.o
 endif
+ifeq ($(BEACON),1)
+APP_SOURCES := $(filter-out main.c,$(APP_SOURCES))
+NB_OBJECTS += $(BUILD)/beacon.o
+endif
 SDK_SOURCES := \
 	$(IDF)/esp_hw_support/port/esp32s3/rtc_clk.c \
 	$(IDF)/esp_hw_support/port/esp32s3/rtc_init.c \
@@ -127,6 +142,9 @@ all: $(BUILD)/iq-source.bin
 $(BUILD)/%.o: src/%.c $(wildcard src/*.h) $(wildcard $(PROTOCOL)/*.h) sdkconfig.h | $(BUILD)
 	$(CC) $(APP_CFLAGS) -c $< -o $@
 
+$(BUILD)/beacon.o: $(BEACON_SRC) $(wildcard src/*.h) $(wildcard $(PROTOCOL)/*.h) sdkconfig.h | $(BUILD)
+	$(CC) $(APP_CFLAGS) -c $< -o $@
+
 $(BUILD)/dsp_core1.o: src/dsp.c src/dsp.h src/dsp_taps.h | $(BUILD)
 	$(CC) $(APP_CFLAGS) -DDSP_TAPS_EXTERN -DDSP_FUNC=dsp_unit_core1 '-DDSP_ATTR=__attribute__((section(".core1_text")))' -c $< -o $@
 

diff --git a/firmware/src/platform.c b/firmware/src/platform.c
index 618c417..0037c18 100644
--- a/firmware/src/platform.c
+++ b/firmware/src/platform.c
@@ -2,6 +2,7 @@
 
 #include "hal/clk_gate_ll.h"
 #include "hal/cpu_utility_ll.h"
+#include "hal/regi2c_ctrl_ll.h"
 #include "hal/systimer_ll.h"
 #include "soc/rtc.h"
 #include "soc/rtc_cntl_reg.h"
@@ -23,12 +24,17 @@ static void disable_watchdogs(void)
 {
     for (unsigned group = 0; group < 2; group++) {
         REG(TIMG_WDTWPROTECT_REG(group)) = WDT_WRITE_KEY;
-        REG(TIMG_WDTCONFIG0_REG(group)) &= ~TIMG_WDT_EN;
+        REG(TIMG_WDTCONFIG0_REG(group)) &= ~(TIMG_WDT_EN | TIMG_WDT_FLASHBOOT_MOD_EN); /* flash boot arms it in this mode too */
         REG(TIMG_WDTWPROTECT_REG(group)) = 0;
     }
     REG(RTC_CNTL_WDTWPROTECT_REG) = WDT_WRITE_KEY;
-    REG(RTC_CNTL_WDTCONFIG0_REG) &= ~RTC_CNTL_WDT_EN;
+    REG(RTC_CNTL_WDTCONFIG0_REG) &= ~(RTC_CNTL_WDT_EN | RTC_CNTL_WDT_FLASHBOOT_MOD_EN);
     REG(RTC_CNTL_WDTWPROTECT_REG) = 0;
+    /* The super watchdog resets the chip unless fed. The ROM already lets the hardware feed it; make sure, as ESP-IDF's
+     * bootloader does. */
+    REG(RTC_CNTL_SWD_WPROTECT_REG) = RTC_CNTL_SWD_WKEY_VALUE;
+    REG(RTC_CNTL_SWD_CONF_REG) |= RTC_CNTL_SWD_AUTO_FEED_EN;
+    REG(RTC_CNTL_SWD_WPROTECT_REG) = 0;
 }
 
 void platform_init(void)
@@ -37,6 +43,11 @@ void platform_init(void)
 
     rtc_config_t rtc = RTC_CONFIG_DEFAULT();
     rtc_init(rtc);
+    /* As ESP-IDF's rtc_clk_init(): the analog bus to the BBPLL, the crystal frequency and the 8 MHz RC clock. A load into RAM
+     * finds them set up by the ROM; a boot from flash does not, and the CPU clock then never reaches 240 MHz. */
+    regi2c_ctrl_ll_i2c_bbpll_enable();
+    rtc_clk_xtal_freq_update(SOC_XTAL_FREQ_40M);
+    rtc_clk_8m_enable(true, false);
     rtc_cpu_freq_config_t cpu;
     if (!rtc_clk_cpu_freq_mhz_to_config(CPU_MHZ, &cpu))
         for (;;) {
@@ -49,6 +60,11 @@ void platform_init(void)
 
     /* rtc_init() may re-arm the RTC watchdog. */
     disable_watchdogs();
+
+    /* Keep the baseband's analog control bus powered: every PHY, PLL and transmitter register write goes over it. The ROM's
+     * download mode leaves it forced on (a load into RAM works); a boot from flash does not, and then the radio set-up hangs or
+     * the transmitter ignores its frequency and gain updates. */
+    REG(RTC_CNTL_OPTIONS0_REG) |= RTC_CNTL_BB_I2C_FORCE_PU;
 }
 

diff --git a/firmware/src/radio.c b/firmware/src/radio.c
index a94c953..d781bd9 100644
--- a/firmware/src/radio.c
+++ b/firmware/src/radio.c
@@ -738,4 +738,49 @@ uint32_t radio_tx_run(void)
     (void)overruns;
     return (uint32_t)reason << 24 | sat8(underruns) << 16 | (late > 0xFFFF ? 0xFFFF : late);
 }
+#ifdef ESPDR_BEACON
+/* ---- direct keying (standalone beacon) ----------------------------------------------------------------------------
+ * The beacon image has no host: it calls radio_tx_begin() itself and then plays one update at a time, with the same
+ * second-order error feedback and clamps as radio_tx_run(). */
+static int32_t key_e1, key_e2;
+static bool key_on;
+
+void radio_tx_key_on(void)
+{
+    if (!tx.prepared || key_on)
+        return;
+    start_tx_tone_step(1, 0, TX_GAIN_WEAKEST, 0, 0, 0);
+    key_e1 = key_e2 = 0;
+    key_on = true;
+}
+
+void radio_tx_key_update(int32_t q4, unsigned g)
+{
+    if (!key_on)
+        return;
+    g = g < TX_GAIN_STRONGEST ? TX_GAIN_STRONGEST : g > TX_GAIN_WEAKEST ? TX_GAIN_WEAKEST : g;
+    int32_t u = q4 * 4096 - 2 * key_e1 + key_e2;
+    int32_t w = (u + 0x8000) >> 16;
+    key_e2 = key_e1;
+    key_e1 = w * 65536 - u;
+    w = w > TX_MAX_STEPS ? TX_MAX_STEPS : w < -TX_MAX_STEPS ? -TX_MAX_STEPS : w;
+    tx_set_gain(g);
+    analog_write(I2C_SDM, 5, (uint8_t)((int32_t)(tx.word & 0xFF) + w));
+}
+
+unsigned radio_tx_key_off(void)
+{
+    if (key_on) {
+        analog_write(I2C_SDM, 5, (uint8_t)(tx.word & 0xFF));
+        start_tx_tone_step(0, 0, 0, 0, 0, 0);
+        key_on = false;
+    }
+    if (tx.prepared) {
+        txcal_work_mode();
+        receiver.status = reconfigure(true);
+        tx.prepared = false;
+    }
+    return receiver.status;
+}
+#endif
 #endif
